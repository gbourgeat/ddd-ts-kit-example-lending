{
  "name": "lending",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "node node_modules/@typescript/native/bin/tsc -p tsconfig.json --noEmit",
    "build": "node node_modules/@typescript/native/bin/tsc -p tsconfig.build.json && ddd-ts-kit build-aliases",
    "lint": "ddd-ts-kit lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "ci:typecheck": "npm run typecheck",
    "ci:lint": "ddd-ts-kit lint",
    "ci:format": "npm run format:check",
    "ci:arch": "npm run ci:arch:check && npm run ci:arch:graph",
    "ci:arch:check": "ddd-ts-kit check",
    "ci:arch:graph": "npm run depcruise",
    "ci:deadcode": "knip",
    "ci:test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "ci:test:integration": "echo \"Adapter specs run with the unit specs under jest.\"",
    "ci:test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js --passWithNoTests",
    "ci:docs": "ddd-ts-kit docs --check && node dist/scripts/openapi.js --check && node dist/scripts/events.js --check && ddd-ts-kit sdk --check",
    "ci:audit": "npm audit --omit=dev --audit-level=high",
    "ci:build": "npm run build && npm run sdk:build",
    "start": "node dist/src/main.js",
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/platform/observability/tracing.ts --import ddd-ts-kit/dist/refresh-declarations.js src/main.ts",
    "lint:fix": "eslint . --fix",
    "hooks:install": "lefthook install",
    "check:arch": "ddd-ts-kit check",
    "depcruise": "ddd-ts-kit depcruise-config --check && depcruise src --config .dependency-cruiser.cjs",
    "deadcode": "knip",
    "quality": "npm run format:check && npm run lint && npm run check:arch && npm run depcruise && npm run deadcode",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:mutation": "stryker run && ddd-ts-kit mutation",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.js --passWithNoTests",
    "openapi:generate": "npm run build && node dist/scripts/openapi.js",
    "openapi:check": "npm run build && node dist/scripts/openapi.js --check",
    "events:generate": "npm run build && node dist/scripts/events.js",
    "events:check": "npm run build && node dist/scripts/events.js --check",
    "docs:generate": "ddd-ts-kit docs && npm run build && node dist/scripts/openapi.js && node dist/scripts/events.js && ddd-ts-kit sdk",
    "docs:check": "ddd-ts-kit docs --check && npm run build && node dist/scripts/openapi.js --check && node dist/scripts/events.js --check && ddd-ts-kit sdk --check",
    "regenerate": "ddd-ts-kit depcruise-config --write && npm run docs:generate",
    "db:client": "prisma generate && prisma migrate diff --from-empty --to-schema prisma/schema --script -o generated/schema.sql",
    "db:generate": "ddd-ts-kit prisma-generate --name",
    "db:migrate": "prisma migrate deploy",
    "pretypecheck": "npm run db:client",
    "prebuild": "npm run db:client",
    "pretest": "npm run db:client",
    "pretest:e2e": "npm run db:client",
    "db:audit-guard": "node --input-type=module -e \"import { auditGuardStatements } from '@ddd-ts-kit/audit/prisma'; console.log(auditGuardStatements('audit').join(';\\n') + ';')\"",
    "privacy:erase": "tsx --env-file-if-exists=.env scripts/privacy-erase.ts",
    "privacy:export": "tsx --env-file-if-exists=.env scripts/privacy-export.ts",
    "privacy:purge": "tsx --env-file-if-exists=.env scripts/privacy-purge.ts",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run test:e2e && npm run check:arch && npm run depcruise && npm run deadcode && npm run docs:check",
    "sdk:generate": "ddd-ts-kit sdk",
    "sdk:build": "node node_modules/@typescript/native/bin/tsc -b clients",
    "start:servicing": "node dist/src/apps/servicing/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/lib-storage": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@confluentinc/kafka-javascript": "^1.11.0",
    "@ddd-ts-kit/aspects": "^0.96.0",
    "@ddd-ts-kit/audit": "^0.96.0",
    "@ddd-ts-kit/auth": "^0.96.0",
    "@ddd-ts-kit/events": "^0.96.0",
    "@ddd-ts-kit/http": "^0.96.0",
    "@ddd-ts-kit/kafka": "^0.96.0",
    "@ddd-ts-kit/kernel": "^0.96.0",
    "@ddd-ts-kit/prisma": "^0.96.0",
    "@ddd-ts-kit/redis": "^0.96.0",
    "@ddd-ts-kit/s3": "^0.96.0",
    "@ddd-ts-kit/scheduling": "^0.96.0",
    "@ddd-ts-kit/sentry": "^0.96.0",
    "@ddd-ts-kit/tracing": "^0.96.0",
    "@ddd-ts-kit/validation": "^0.96.0",
    "@ddd-ts-kit/winston": "^0.96.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^11.6.0",
    "busboy": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.2.0",
    "ioredis": "^6.0.0",
    "jose": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ddd-ts-kit/eslint-plugin": "^0.96.0",
    "@ddd-ts-kit/testing": "^0.96.0",
    "@electric-sql/pglite": "0.5.9",
    "@electric-sql/pglite-socket": "0.2.12",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@jest/globals": "^30.5.2",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/jest-runner": "^10.1.1",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@~7.0.2",
    "ddd-ts-kit": "^0.96.0",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "knip": "^6.41.0",
    "lefthook": "^2.2.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "overrides": {
    "multer": "^2.5.0",
    "qs": "^6.16.0"
  },
  "workspaces": [
    "clients/*"
  ],
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "@confluentinc/kafka-javascript@1.11.0": true,
    "@swc/core@1.16.20": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "lefthook@2.2.2": true,
    "@parcel/watcher@2.6.0": true,
    "protobufjs@7.6.6": true
  }
}
