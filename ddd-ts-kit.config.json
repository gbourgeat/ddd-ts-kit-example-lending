{
  "initVersion": "0.94.1",
  "sourceRoot": "src",
  "contextsDir": "src/contexts",
  "sharedKernelDir": "src/shared-kernel",
  "platformDir": "src/platform",
  "importAlias": "@/",
  "importExtension": "none",
  "stack": {
    "http": "nest",
    "validation": "class-validator",
    "di": "nest",
    "events": "outbox",
    "orm": "prisma",
    "database": "postgres",
    "tests": "jest",
    "docsUi": "scalar",
    "ci": "github",
    "authn": "keycloak",
    "authz": "rebac",
    "broker": "kafka",
    "cache": "redis",
    "httpCache": "none",
    "rpc": "none",
    "storage": "s3",
    "audit": "on",
    "eventSourcing": "on",
    "privacy": "on",
    "errors": "sentry",
    "logger": "winston",
    "style": "explicit",
    "refusals": "named",
    "routes": "nest",
    "representations": "negotiated",
    "forms": "on",
    "schemas": "shared",
    "valueObjects": "throwing",
    "literals": "named",
    "values": "classes",
    "queue": "redis",
    "packageManager": "npm",
    "tenancy": "shared-table"
  },
  "contexts": {
    "identity": {
      "classification": "generic",
      "upstreams": [],
      "tenancy": "control-plane"
    },
    "data-protection": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "identity",
          "relationship": "conformist"
        }
      ]
    },
    "credit-policy": {
      "classification": "supporting",
      "upstreams": []
    },
    "credit-scoring": {
      "classification": "core",
      "upstreams": []
    },
    "brokerage": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "identity",
          "relationship": "conformist"
        }
      ]
    },
    "customer-due-diligence": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "identity",
          "relationship": "conformist"
        },
        {
          "context": "data-protection",
          "relationship": "customer-supplier"
        }
      ]
    },
    "branch-network": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "customer-due-diligence",
          "relationship": "published-language"
        },
        {
          "context": "identity",
          "relationship": "conformist"
        }
      ]
    },
    "credit-application": {
      "classification": "core",
      "upstreams": [
        {
          "context": "credit-policy",
          "relationship": "published-language"
        },
        {
          "context": "credit-scoring",
          "relationship": "customer-supplier"
        },
        {
          "context": "customer-due-diligence",
          "relationship": "customer-supplier"
        },
        {
          "context": "brokerage",
          "relationship": "published-language"
        },
        {
          "context": "branch-network",
          "relationship": "published-language"
        },
        {
          "context": "identity",
          "relationship": "conformist"
        }
      ],
      "extraDirectories": ["composition"],
      "modules": {
        "file": {},
        "assessment": {},
        "decision": {},
        "offer": {}
      }
    },
    "servicing": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "credit-application",
          "relationship": "published-language"
        },
        {
          "context": "credit-policy",
          "relationship": "published-language"
        },
        {
          "context": "identity",
          "relationship": "conformist"
        },
        {
          "context": "data-protection",
          "relationship": "customer-supplier"
        }
      ],
      "modules": {
        "ledger": {},
        "instalments": {},
        "arrears": {}
      },
      "deployable": true
    },
    "financial-crime": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "servicing",
          "relationship": "published-language"
        },
        {
          "context": "identity",
          "relationship": "conformist"
        }
      ]
    },
    "reporting": {
      "classification": "supporting",
      "upstreams": [
        {
          "context": "credit-application",
          "relationship": "published-language"
        },
        {
          "context": "servicing",
          "relationship": "published-language"
        },
        {
          "context": "branch-network",
          "relationship": "published-language"
        },
        {
          "context": "identity",
          "relationship": "conformist"
        }
      ]
    }
  },
  "rules": {},
  "domainAllowedPackages": ["@ddd-ts-kit/kernel"],
  "applicationAllowedPackages": ["@ddd-ts-kit/kernel", "@ddd-ts-kit/auth"],
  "worktrees": "required",
  "formatOnWrite": true,
  "agents": {
    "profile": "regulated"
  },
  "sdk": {
    "name": "{project}-{document}-client"
  },
  "deviations": [
    {
      "what": "contexts.identity.tenancy",
      "adr": "0001",
      "reason": "The identity context is the control plane of the tenants: it decides who belongs to which, and its rows belong to none of them."
    }
  ]
}
