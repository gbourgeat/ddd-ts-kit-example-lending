{
  "initVersion": "0.94.1",
  "sourceRoot": "src",
  "contextsDir": "src/contexts",
  "sharedKernelDir": "src/shared-kernel",
  "platformDir": "src/platform",
  "importAlias": "@/",
  "importExtension": "none",
  "stack": {
    "http": "nest",
    "validation": "class-validator",
    "di": "nest",
    "events": "outbox",
    "orm": "prisma",
    "database": "postgres",
    "tests": "jest",
    "docsUi": "scalar",
    "ci": "github",
    "authn": "keycloak",
    "authz": "rebac",
    "broker": "kafka",
    "cache": "redis",
    "httpCache": "none",
    "rpc": "none",
    "storage": "s3",
    "audit": "on",
    "eventSourcing": "on",
    "privacy": "on",
    "errors": "sentry",
    "logger": "winston",
    "style": "explicit",
    "refusals": "named",
    "routes": "nest",
    "representations": "negotiated",
    "forms": "on",
    "schemas": "shared",
    "valueObjects": "throwing",
    "literals": "named",
    "values": "classes",
    "queue": "redis",
    "packageManager": "npm",
    "tenancy": "shared-table"
  },
  "contexts": {},
  "rules": {},
  "domainAllowedPackages": ["@ddd-ts-kit/kernel"],
  "applicationAllowedPackages": ["@ddd-ts-kit/kernel", "@ddd-ts-kit/auth"],
  "worktrees": "required",
  "formatOnWrite": true,
  "agents": {
    "profile": "regulated"
  },
  "sdk": {
    "name": "{project}-{document}-client"
  }
}
