// ddd-ts-kit:models
model FinancialCrimeAlert {
  id           String   @id
  registeredAt DateTime @map("registered_at") @db.Timestamptz(3)
  repaymentReference String @map("repayment_reference")
  closedAt     DateTime? @map("closed_at") @db.Timestamptz(3)
  closureReason String?  @map("closure_reason")
  version      Int
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  createdBy    String   @map("created_by")
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy    String   @map("updated_by")

  @@index([tenantId, id], map: "alerts_tenant_idx")
  @@map("alerts")
  @@schema("financial_crime")
}

model FinancialCrimeSuspiciousActivityReport {
  id           String   @id
  registeredAt DateTime @map("registered_at") @db.Timestamptz(3)
  subjectReference String @map("subject_reference")
  filingReference String? @map("filing_reference")
  version      Int
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  createdBy    String   @map("created_by")
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy    String   @map("updated_by")

  @@index([tenantId, id], map: "suspicious_activity_reports_tenant_idx")
  @@map("suspicious_activity_reports")
  @@schema("financial_crime")
}
// /ddd-ts-kit:models
