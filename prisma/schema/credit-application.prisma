// The models and enums of the bounded context credit-application, in its database schema "credit_application":
// no relation to another context. A column changes here with the mapper of the context, in one commit.
// ddd-ts-kit:models
model CreditApplicationOffer {
  id           String   @id
  registeredAt DateTime @map("registered_at") @db.Timestamptz(3)
  // TODO(domain): add one field per field of OfferState, with the type and the constraints the storage must enforce; then run `npm run db:client` and `npm run db:generate <what-it-does>`.
  version      Int
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  createdBy    String   @map("created_by")
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy    String   @map("updated_by")

  @@index([tenantId, id], map: "offers_tenant_idx")
  @@map("offers")
  @@schema("credit_application")
}

/// The application list read model: one row per submitted application, written by the reaction to its submission.
model CreditApplicationListedApplication {
  id                  String   @id
  applicantId         String   @map("applicant_id")
  requestedAmountCents Int     @map("requested_amount_cents")
  durationMonths      Int      @map("duration_months")
  submittedAt         DateTime @map("submitted_at") @db.Timestamptz(3)
  tenantId            String   @map("tenant_id")

  @@index([tenantId, id], map: "listed_applications_tenant_idx")
  @@map("listed_applications")
  @@schema("credit_application")
}
// /ddd-ts-kit:models
