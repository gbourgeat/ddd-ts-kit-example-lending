// ddd-ts-kit:models
model CreditPolicyProduct {
  id                     String   @id
  registeredAt           DateTime @map("registered_at") @db.Timestamptz(3)
  amountMinimumCents     Int      @map("amount_minimum_cents")
  amountMaximumCents     Int      @map("amount_maximum_cents")
  durationMinimumMonths  Int      @map("duration_minimum_months")
  durationMaximumMonths  Int      @map("duration_maximum_months")
  arrangementFeeCents    Int      @map("arrangement_fee_cents")
  insuranceMandatory     Boolean  @map("insurance_mandatory")
  scoreThreshold Int @map("score_threshold")
  version      Int
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  createdBy    String   @map("created_by")
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy    String   @map("updated_by")

  @@index([tenantId, id], map: "products_tenant_idx")
  @@map("products")
  @@schema("credit_policy")
}

model CreditPolicyRateGrid {
  id           String   @id
  registeredAt DateTime @map("registered_at") @db.Timestamptz(3)
  productId    String @map("product_id")
  effectiveFrom DateTime @map("effective_from")
  rates        Json     @default("[]") @map("rates")
  version      Int
  tenantId     String   @map("tenant_id")
  createdAt    DateTime @map("created_at") @db.Timestamptz(3)
  createdBy    String   @map("created_by")
  updatedAt    DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy    String   @map("updated_by")

  @@index([tenantId, id], map: "rate_grids_tenant_idx")
  @@map("rate_grids")
  @@schema("credit_policy")
}

model CreditPolicyLegalMaximumRate {
  id           String   @id
