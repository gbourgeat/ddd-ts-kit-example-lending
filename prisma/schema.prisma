generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["messaging", "event_store", "audit", "identity", "authorization"]
}

// The outbox and the idempotency table, from @ddd-ts-kit/prisma. Keep the field names: the
// stores are typed against them.
model OutboxRecord {
  id            String    @id
  sequence      BigInt    @unique @default(autoincrement())
  type          String
  version       Int
  occurredAt    String    @map("occurred_at")
  payload       Json?
  traceparent   String?
  correlationId String?   @map("correlation_id")
  /// The tenant of the event, so that its consumers run in that tenant.
  tenantId      String?   @map("tenant_id")
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @map("next_attempt_at") @db.Timestamptz(3)
  lastErrorCode String?   @map("last_error_code")
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt, sequence])
  @@map("outbox")
  @@schema("messaging")
}

model ProcessedEvent {
  consumer    String
  eventId     String   @map("event_id")
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(3)

  @@id([consumer, eventId])
  @@map("processed_events")
  @@schema("messaging")
}

// The instances of the process managers, from @ddd-ts-kit/prisma, saved in the transaction of each step.
model ProcessInstance {
  /// The empty text outside any tenant: two tenants may use the same correlation key.
  tenantId  String   @default("") @map("tenant_id")
  name      String
  id        String
  /// JSON as text: a state may be null.
  state     String
  version   Int
  ended     Boolean  @default(false)
  timeouts  Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, name, id])
  @@map("process_instances")
  @@schema("messaging")
}

// The relation tuples of the rebac schema, written in the transaction of the change they describe.
// Platform-wide, not a context: the tuples name the elements of every context.
model RelationTuple {
  object   String
  relation String
  subject  String

  @@id([object, relation, subject])
  @@index([subject], map: "relation_tuples_subject_idx")
  @@map("relation_tuples")
  @@schema("authorization")
}

// One schema per bounded context, no relation across contexts.
// ddd-ts-kit:models
/// Keyed by the subject the identity provider gives the person. No password is stored.
model IdentityAccount {
  id            String                         @id
  email         String
  displayName   String                         @map("display_name")
  status        IdentityAccountStatus
  provisionedAt DateTime                       @map("provisioned_at") @db.Timestamptz(3)
  deactivatedAt DateTime?                      @map("deactivated_at") @db.Timestamptz(3)
  version       Int
  createdAt     DateTime                       @map("created_at") @db.Timestamptz(3)
  createdBy     String                         @map("created_by")
  updatedAt     DateTime                       @map("updated_at") @db.Timestamptz(3)
  updatedBy     String                         @map("updated_by")

  @@map("accounts")
  @@schema("identity")
}

/// Keyed by the slug, which is also the tenant id when the project has tenants.
model IdentityOrganisation {
  id        String   @id
  name      String
  openedBy  String   @map("opened_by")
  openedAt  DateTime @map("opened_at") @db.Timestamptz(3)
  version   Int
  createdAt DateTime @map("created_at") @db.Timestamptz(3)
  createdBy String   @map("created_by")
  updatedAt DateTime @map("updated_at") @db.Timestamptz(3)
  updatedBy String   @map("updated_by")

  @@map("organisations")
  @@schema("identity")
}

/// One current membership per account and organisation: the partial unique index is the guard.
model IdentityMember {
  id             String                      @id
  organisationId String                      @map("organisation_id")
  accountId      String                      @map("account_id")
  role           IdentityMemberRole
  joinedAt       DateTime                    @map("joined_at") @db.Timestamptz(3)
  removedAt      DateTime?                   @map("removed_at") @db.Timestamptz(3)
  version        Int
  createdAt      DateTime                    @map("created_at") @db.Timestamptz(3)
  createdBy      String                      @map("created_by")
  updatedAt      DateTime                    @map("updated_at") @db.Timestamptz(3)
  updatedBy      String                      @map("updated_by")

  // Preview feature `partialIndexes`: after an upgrade of Prisma, check generated/schema.sql keeps the WHERE.
  @@unique([organisationId, accountId], map: "members_current_idx", where: { removedAt: null })
  @@index([accountId], map: "members_account_idx")
  @@map("members")
  @@schema("identity")
}

model IdentityInvitation {
  id             String                            @id
  organisationId String                            @map("organisation_id")
  email          String
  role           IdentityMemberRole
  tokenHash      String                            @unique @map("token_hash")
  invitedBy      String                            @map("invited_by")
  issuedAt       DateTime                          @map("issued_at") @db.Timestamptz(3)
  expiresAt      DateTime                          @map("expires_at") @db.Timestamptz(3)
  status         IdentityInvitationStatus
  answeredAt     DateTime?                         @map("answered_at") @db.Timestamptz(3)
  version        Int
  createdAt      DateTime                          @map("created_at") @db.Timestamptz(3)
  createdBy      String                            @map("created_by")
  updatedAt      DateTime                          @map("updated_at") @db.Timestamptz(3)
  updatedBy      String                            @map("updated_by")

  @@index([organisationId, status], map: "invitations_organisation_idx")
  @@map("invitations")
  @@schema("identity")
}

model IdentityDelegation {
  id             String    @id
  organisationId String    @map("organisation_id")
  delegatorId    String    @map("delegator_id")
  delegateId     String    @map("delegate_id")
  /// The rights lent, separated by commas: a right is a word of `MemberRight`, which holds none.
  rights         String
  startsAt       DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime  @map("ends_at") @db.Timestamptz(3)
  endedAt        DateTime? @map("ended_at") @db.Timestamptz(3)
  version        Int
  createdAt      DateTime  @map("created_at") @db.Timestamptz(3)
  createdBy      String    @map("created_by")
  updatedAt      DateTime  @map("updated_at") @db.Timestamptz(3)
  updatedBy      String    @map("updated_by")

  @@index([organisationId, delegateId], map: "delegations_delegate_idx")
  @@index([organisationId, delegatorId], map: "delegations_delegator_idx")
  @@map("delegations")
  @@schema("identity")
}

/// Whether an account may still act: a deactivated account keeps its history and signs in no more.
enum IdentityAccountStatus {
  active
  deactivated

  @@map("account_status")
  @@schema("identity")
}

/// The role of a member in an organisation: what the member may do there follows from it.
enum IdentityMemberRole {
  owner
  admin
  member

  @@map("member_role")
  @@schema("identity")
}

/// Where an invitation stands: pending until its person answers, or the organisation takes it back.
enum IdentityInvitationStatus {
  pending
  accepted
  declined
  revoked

  @@map("invitation_status")
  @@schema("identity")
}
// /ddd-ts-kit:models

// The event store of @ddd-ts-kit/prisma: the events, the snapshots, the checkpoints and the
// keys of the data subjects. Keep the table and column names: the stores run raw statements
// against them. It records no tenant.
model StoredEventsHead {
  id       Int    @id @db.SmallInt
  position BigInt

  @@map("stored_events_head")
  @@schema("event_store")
}

model StoredEvent {
  position      BigInt   @id
  stream        String
  version       Int
  eventId       String   @unique @map("event_id")
  type          String
  schemaVersion Int      @map("schema_version")
  data          Json
  metadata      Json
  occurredAt    DateTime @map("occurred_at") @db.Timestamptz(3)
  tenantId      String?  @map("tenant_id")
  recordedAt    DateTime @default(now()) @map("recorded_at") @db.Timestamptz(3)

  @@unique([stream, version])
  @@map("stored_events")
  @@schema("event_store")
}

model StreamSnapshot {
  stream        String   @id
  version       Int
  schemaVersion Int      @map("schema_version")
  data          Json
  takenAt       DateTime @default(now()) @map("taken_at") @db.Timestamptz(3)

  @@map("stream_snapshots")
  @@schema("event_store")
}

model SubscriptionCheckpoint {
  subscriber String   @id
  position   BigInt
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("subscription_checkpoints")
  @@schema("event_store")
}

/// One key per data subject: erasing the subject deletes its row.
model SubjectKey {
  subject   String   @id
  keyId     String   @unique @map("key_id")
  material  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("subject_keys")
  @@schema("event_store")
}

// Prisma writes no trigger: `npm run db:generate <name>` adds the statements that make the audit trail append-only (UPDATE, DELETE and TRUNCATE refused) to the migration that creates it; `npm run db:audit-guard` prints them for a migration written by hand.
/// The audit trail of @ddd-ts-kit/audit: written by PrismaAuditTrail with raw statements, append-only once the guard is migrated.
model AuditEntry {
  id             String   @unique
  chain          String
  sequence       BigInt
  occurredAt     DateTime @map("occurred_at") @db.Timestamptz(3)
  category       String
  action         String
  outcome        String
  reason         String?
  actorId        String   @map("actor_id")
  actorType      String   @map("actor_type")
  actorTenantId  String?  @map("actor_tenant_id")
  tenantId       String?  @map("tenant_id")
  impersonatedBy String?  @map("impersonated_by")
  sessionId      String?  @map("session_id")
  resourceType   String?  @map("resource_type")
  resourceId     String?  @map("resource_id")
  context        String?
  correlationId  String   @map("correlation_id")
  causationId    String?  @map("causation_id")
  origin         String
  changes        Json?
  extensions     Json     @default("{}")
  previousHash   String   @map("previous_hash")
  hash           String

  @@id([chain, sequence])
  @@index([occurredAt, chain, sequence], map: "audit_entries_occurred_idx")
  @@index([actorId, occurredAt], map: "audit_entries_actor_idx")
  @@index([resourceType, resourceId], map: "audit_entries_resource_idx")
  @@index([correlationId], map: "audit_entries_correlation_idx")
  @@map("audit_entries")
  @@schema("audit")
}

/// The archives of the audit trail: one row per range of a chain written to the file storage, append-only, read by the guard.
model AuditArchive {
  chain        String
  fromSequence BigInt   @map("from_sequence")
  toSequence   BigInt   @map("to_sequence")
  lastHash     String   @map("last_hash")
  entries      Int
  fileKey      String   @map("file_key")
  fileDigest   String   @map("file_digest")
  archivedAt   DateTime @map("archived_at") @db.Timestamptz(3)

  @@id([chain, toSequence])
  @@map("audit_archives")
  @@schema("audit")
}

/// The head of each chain of the audit trail: the row an append locks.
model AuditChain {
  chain    String @id
  sequence BigInt
  hash     String

  @@map("audit_chains")
  @@schema("audit")
}
