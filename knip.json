{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/contexts/*/*.module.ts",
        "src/contexts/*/published-language/index.ts",
        "scripts/*.ts",
        "test/e2e/**/*.ts"
      ],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts", "prisma/**/*.prisma"],
      "mcp": false,
      "jest": {
        "config": ["jest.config.js", "jest.e2e.config.js", "jest.mutation.config.js"],
        "entry": [
          "src/**/*.spec.ts",
          "src/contexts/*/test/fakes/*.ts",
          "src/contexts/*/test/worlds/*.ts",
          "test/architecture/**/*.spec.ts",
          "test/e2e/**/*.e2e.spec.ts"
        ]
      }
    }
  },
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    "src/contexts/*/*.codes.ts": ["types"]
  },
  "ignoreWorkspaces": ["clients/*"]
}
